# ============================================================
# PrecIA - Configurações de Ambiente (Sprint 1, Sprint 2 & Sprint 3)
# ============================================================

# Chaves de IA / Visão Computacional (Configurar ao menos uma)
GEMINI_API_KEY=

# Chave de Busca de Preços (Google Shopping via SerpApi ou Firecrawl)
SERPAPI_KEY=

# Rate Limiting com Upstash Redis (Opcional - Em dev usa in-memory automático)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Supabase (PostgreSQL, Auth e Row Level Security - Sprint 2)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Tags e Credenciais de Afiliados (Server-Side - Sprint 2)
AMAZON_AFFILIATE_TAG=
MERCADOLIVRE_AFFILIATE_TOOL=
MAGALU_PARTNER_ID=
KABUM_AFFILIATE_TAG=

# Automação e Cron Jobs (Sprint 3)
CRON_SECRET=your-secure-cron-secret-token

# Mensageria WhatsApp / Evolution API (Sprint 3)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# URL Base da Aplicação
NEXT_PUBLIC_APP_URL=
